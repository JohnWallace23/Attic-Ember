source "https://rubygems.org"

# Matches the exact gem versions GitHub Pages builds with, so what you
# see locally is what goes live. Includes Jekyll + jekyll-feed for you.
gem "github-pages", group: :jekyll_plugins

# Ruby 3.0+ dropped webrick from the standard library, and Jekyll's local
# server needs it. Harmless on GitHub (only used by `jekyll serve`).
gem "webrick", "~> 1.8"
